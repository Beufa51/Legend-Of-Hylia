[node name="VillageOuest" parent="." instance=ExtResource("2")]
grille = Vector2i(1, 2)
animaux = PackedStringArray("c 6 10", "h 20 9", "c 15 12")
pnjs = PackedStringArray("Woman 10 9 haut | Colette | Oh, tu es la nouvelle recrue ! Tout le village parle de ton épreuve d'adoubement. // On raconte que le donjon sous le temple a la forme d'un grand coq. // Un coq dans un donjon... Moi, je préfère ceux de ma basse-cour !", "OldMan 8 6 droite | Vieux Gaspard | Le coq chante chaque aube depuis mille ans. // S'il se taisait un jour, le royaume tremblerait. // Ton père tenait la lance avant toi. Garde-la bien, petite.", "Boy 18 5 gauche | Tom | Tu as une vraie lance de la garde ! Tu me la prêtes ? // ... Non ? Tant pis. // Un conseil : n'embête pas les poules. Elles se vengent.")
passages = PackedStringArray("4 5 ! La porte est fermée à clé.", "13 5 InterieurStand 12 9")
