[node name="VillageOuest" parent="." instance=ExtResource("2")]
grille = Vector2i(1, 2)
animaux = PackedStringArray("c 6 10", "h 20 9", "c 16 10")
pnjs = PackedStringArray("Woman 10 9 haut | Colette | [fragment_gauche] Tu as rapporté l'aile ?! Vue du ciel, elle a la forme d'une plume géante, dit-on. // Moi, je savais bien que tu réussirais. ## [plume2] Il paraît que tu as allumé des braseros dans le noir ? Tu n'as pas peur de te brûler les moustaches ! ## Oh, tu es la nouvelle recrue ! Tout le village parle de ton épreuve d'adoubement. // On raconte que le donjon sous le temple a la forme d'un grand coq. // Un coq dans un donjon... Moi, je préfère ceux de ma basse-cour !", "OldMan 9 7 droite | Vieux Gaspard | [fragment_gauche] Une aile entière... Ton père n'a jamais dépassé la quatrième plume. // Il serait fier. Moi aussi, petite. ## [plume3] Tu as réveillé le chant du coq, alors ? // Les cloches ne mentent jamais : écoute bien avant de frapper. ## Le coq chante chaque aube depuis mille ans. // S'il se taisait un jour, le royaume tremblerait. // Ton père tenait la lance avant toi. Garde-la bien, petite.", "Boy 20 8 gauche | Tom | [plume4] On dit que des statues de pierre surveillent la quatrième plume ! // Moi, je me serais caché derrière un pilier. Et toi ? ## Tu as une vraie lance de la garde ! Tu me la prêtes ? // ... Non ? Tant pis. // Un conseil : n'embête pas les poules. Elles se vengent.")
passages = PackedStringArray("5 6 ! La porte est fermée à clé.", "17 6 InterieurStand 12 9")
layout = PackedStringArray("A..a..P..bb:::ba..P..a..b", "...........:::..........b", "A..........:::.......a..b", "..........g:::..........b", "A..M.......:::.R....g...b", "..w........:::.......j..b", "...::::::::::::::::::::::", "b..::::::::::::::::::::::", "b..::::::::::::::::::::::", "b..........:::..........b", "A...wg.....:::...o....A..", "a..f..g..o.:::...oA..a...", "...........:::.......w..b", "...bbbbbbbb:::bbbb......b")

