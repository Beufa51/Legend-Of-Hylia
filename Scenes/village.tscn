[node name="InterieurHeros" parent="." instance=ExtResource("4")]
grille = Vector2i(4, 5)
pnjs = PackedStringArray("Woman 10 7 bas | Maman | [epreuve_reussie] Garde du royaume ! Ma fille, garde du royaume ! // Ton père aurait été si fier de toi. Viens, le repas de fête est prêt ! ## [fragment_gauche] Ma fille, la moitié du blason ! Je vais préparer un grand repas. // Mais d'abord, va te reposer. ## [capitaine_vu] Le capitaine t'a parlé ? Alors file au temple, et fais attention à toi ! ## Bien dormi ? Aujourd'hui, c'est ton grand jour ! // Le capitaine Aubrac t'attend à la caserne, à l'est de la place du village. // N'oublie pas la lance de ton père : elle est posée près de la porte. ... Ah, tu l'as déjà. Brave petite !")
passages = PackedStringArray("12 10 MaisonHeros 6 7", "14 6 $records")
indice = "Tu te réveilles chez toi. Aujourd'hui, c'est ton adoubement ! Parle à Maman, puis rejoins le capitaine à la caserne (à l'est de la place du village)."
layout = PackedStringArray("                         ", "                         ", "                         ", "      #w#y#z#v#x##       ", "      ############       ", "      #L...q..S..#       ", "      #..........#       ", "      #..t......p#       ", "      #......CT..#       ", "      #o.........#       ", "      ######m#####       ", "                         ", "                         ", "                         ")

